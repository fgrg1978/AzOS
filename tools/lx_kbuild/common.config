# Kconfig fragment merged over `tinyconfig` for every lx/ module build
# (RFC-0053 L1). Everything that would put an import or a section in a .ko
# that crates/core/lx-loader refuses is off; the reasons are in the names.
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_SMP=y
CONFIG_MODULES=y
CONFIG_PRINTK=y
CONFIG_EXPERT=y
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_FORTIFY_SOURCE is not set
# CONFIG_FTRACE is not set
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_KCOV is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_CFI_CLANG is not set
# Linux's own arch CRC code (arm64 CRC32 instructions) stays ON: it lives in
# vmlinux, never in a module, and the comparison kernel must be Linux as
# shipped. (riscv's needs Zbc, which rv64imac and this config do not have.)
CONFIG_CRC_OPTIMIZATIONS=y
# CONFIG_MEM_ALLOC_PROFILING is not set
CONFIG_DEBUG_INFO_NONE=y
# What the Linux comparison kernel needs to boot on QEMU virt with an
# initramfs and a console (`run.sh linux`). The modules AzOS loads are built
# with this same configuration, so Linux `insmod`s the very same .ko bytes.
CONFIG_TTY=y
CONFIG_BLK_DEV_INITRD=y
# The initramfs is an uncompressed cpio; RD_XZ would select XZ_DEC=y and
# build the module under test into the kernel.
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_BINFMT_ELF=y
