# aarch64 part of the lx/ module config: 4 KiB pages (the AzOS granule),
# no LSE/BTI/PAC (each adds `.altinstructions` patch sites or notes).
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_LSE_ATOMICS is not set
# CONFIG_ARM64_BTI is not set
# CONFIG_ARM64_BTI_KERNEL is not set
# CONFIG_ARM64_PTR_AUTH is not set
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_ARM64_USE_LSE_ATOMICS is not set
# Console for the Linux comparison kernel (QEMU virt's PL011).
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
