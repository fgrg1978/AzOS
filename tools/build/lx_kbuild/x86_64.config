# x86_64 part of the crates/drivers/lx/ module config (ARCH=x86_64, so 64BIT is fixed y and
# common.config's CONFIG_64BIT=y holds). Off: what puts patch-site tables in
# a module the loader cannot patch (return/indirect thunks, IBT seal sites,
# paravirt, jump labels) or an unwinder table it does not place (ORC).
# CONFIG_MITIGATION_RETPOLINE is not set
# CONFIG_MITIGATION_RETHUNK is not set
# CONFIG_MITIGATION_CALL_DEPTH_TRACKING is not set
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_PARAVIRT is not set
# CONFIG_JUMP_LABEL is not set
# CONFIG_UNWINDER_ORC is not set
CONFIG_UNWINDER_GUESS=y
