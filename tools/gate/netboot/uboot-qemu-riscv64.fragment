#
# Kconfig fragment appended to U-Boot's qemu-riscv64_smode_defconfig by
# tools/gate/netboot/uboot_build.sh (this file only names U-Boot symbols; U-Boot
# itself is GPL-2.0+ and is not in the tree).
#
# The boot command: U-Boot runs the script found at ${scriptaddr}, where its
# boot.scr is read to. The netboot rows put the script there with
# `-device loader`, so the machine has no disk and everything else comes over
# the network.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="source ${scriptaddr}"
CONFIG_BOOTDELAY=0
# Verified boot: `bootm` refuses a FIT image whose configuration is not signed
# by a key in the control device tree marked `required`.
CONFIG_FIT_SIGNATURE=y
# FIT_SIGNATURE only implies these two; without them "sha256,rsa2048" is an
# unknown algorithm and every signed image is refused.
CONFIG_RSA=y
CONFIG_RSA_VERIFY=y
# Off: the bare-metal GNU toolchain cannot link the EFI loader's shared
# objects, and nothing here boots through EFI.
# CONFIG_EFI_LOADER is not set
# CONFIG_CMD_BOOTEFI_SELFTEST is not set
# CONFIG_UNIT_TEST is not set
