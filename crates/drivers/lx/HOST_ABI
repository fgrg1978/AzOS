# The crates/drivers/lx/ host ABI: every symbol the Linux driver server
# (userspace/services/lxsrv) exports to modules. A .ko may import only these
# and the exports of the modules loaded before it (tools/lint/lx_license_lint.py
# --ko). Plain scalars and pointers only, no Linux type; the memory functions
# are the C standard ones. Linux symbols come from lxbase.ko (crates/drivers/lx/glue).
# lxh_hwcap returns the vDSO hwcap word (crates/core/abi/src/vdso.rs), numbered
# per ISA from 0: on aarch64 HWCAP_A64_CRC32 = bit 0, on riscv64 HWCAP_RV_ZBC = bit 1, ...
lxh_alloc
lxh_free
lxh_hwcap
memcmp
memcpy
memmove
memset
