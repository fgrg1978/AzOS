#
# The ids this crate's native drivers answer to, for the hardware bus
# (crates/drivers/hwbus; build.rs turns every crates/drivers/*/hwbus.ids into
# the native match table). One line per id:
#
#   <driver> <selector> [boot] [if=<KCONFIG_SYMBOL>]
#
# <selector>: pci:VVVV:DDDD (hex, * for any) | pciclass:CCCCCC:MMMMMM |
# dt:<compatible> | virtio:<device id>. A line whose symbol is not y in
# .config is left out: a driver the image does not compile claims nothing.
# `boot`: hardware the kernel drives outside the bus (brought up before it, or
# by a boot step that does not ask it); it is bound whatever the policy or the
# topology says, so ring 3 is never handed a window the kernel is using.
# The driver name is what the kernel's driver registry binds
# (kernel/src/boot/hwbus.rs).

# NVM Express controller: class 01, sub class 08, programming interface 02.
nvme             pciclass:010802:ffffff   if=DRV_NVME

# JH7110 SD/MMC controllers (`mmc0@16010000` eMMC, `mmc1@16020000` microSD): a
# Synopsys DesignWare MSHC. The driver (`dwmshc`) serves the removable one; the
# probe refuses a `non-removable` node (the eMMC needs an init sequence this
# driver does not have). `boot`: the controller is the boot disk, brought up
# before the filesystem is mounted.
dw-mshc          dt:starfive,jh7110-mmc   boot   if=BOARD_VF2
# AHCI SATA host: class 01, sub class 06, programming interface 01.
ahci             pciclass:010601:ffffff   if=DRV_AHCI
