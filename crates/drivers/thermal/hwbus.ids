#
# The ids this crate's native drivers answer to, for the hardware bus
# (crates/drivers/hwbus; see crates/drivers/sys/hwbus.ids for the format).
#
# JH7110 temperature sensor (`sfctemp@120e0000`). `boot`: the thermal
# framework reads it from the kernel; ring 3 is never handed the window.

sfctemp          dt:starfive,jh7110-temp   boot   if=BOARD_VF2   if=THERMAL

# SpacemiT K1 temperature sensor block (`thermal@d4018000`, five channels).
# `boot`: the thermal framework reads it from the kernel; ring 3 is never
# handed the window. `if=SOC_K1 if=THERMAL`: the probe arm exists under those
# features (kernel/src/boot/hwbus.rs); SOC_K1 is BOARD_K1's frameworks.
k1-tsensor       dt:spacemit,k1-tsensor    boot   if=SOC_K1   if=THERMAL
