# SCHED.TOML of the micro kernel's QEMU image: two classes, no fair class.
[sched]
partition_window_us = 10000

[class.rt]
cpu_budget_min_pct = 20
cpu_budget_max_pct = 100
policy = "rr"
priority_range = [0, 30]
preemption = "timer-only"
time_slice_ms = 10
admission_control = false

[class.idle]
cpu_budget_min_pct = 0
cpu_budget_max_pct = 100
policy = "rr"
priority_range = [31, 31]
preemption = "timer-only"
time_slice_ms = 10
admission_control = false
