# config/defconfigs/qemu-x86_64-pci.config — qemu-x86_64.config with PCI and the
# NVMe boot disk (`make qemu-pci-x86_64`): QEMU microvm,pcie=on (MSI-X straight
# to the local APIC). q35 needs no ECAM line: its MCFG names the window.
# Original header follows.
#
# config/defconfigs/qemu-x86_64.config — x86_64 port SKELETON
#
# Not a bootable configuration: the x86_64 port is a skeleton (every arch
# method todo!(), asm stubs; see config/Kconfig.arch ARCH_X86_64). The one
# thing built from this file:
#   make ARCH=x86_64 check  — expands it into build/check-x86_64.config and
#                             type-checks the kernel for x86_64-unknown-none
# Its errors and compile_error!s are the porting checklist.


CONFIG_PRESET_ROBOT=y
CONFIG_ARCH_X86_64=y
CONFIG_X86_64_LEVEL_V2=y

CONFIG_LINUX_ABI=y
CONFIG_LOG_LEVEL_DEBUG=y

CONFIG_DRV_PCI=y
# microvm,pcie=on: no MCFG, no 0xCF8; its ECAM is fixed.
CONFIG_X86_PCI_ECAM_BASE=0xE0000000
CONFIG_DRV_NVME=y
