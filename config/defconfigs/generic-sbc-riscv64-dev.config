# config/defconfigs/generic-sbc-riscv64-dev.config — generated by tools/gen_defconfigs.py; do not edit
#
# Preset generic, hardware class sbc, riscv64, dev build.
# Edit the fragments under config/fragments/ and run `python3 tools/gen_defconfigs.py`.
# `make defconfig-generic-sbc-riscv64-dev` loads it.

# config/fragments/presets/generic.frag — PRESET GENERIC: General-purpose kernel
# The one line a defconfig needs: the preset sets the defaults of every axis
# (config/axes/Kconfig.preset).
CONFIG_PRESET_GENERIC=y

# config/fragments/hwclass/sbc.frag — HWCLASS SBC: single-board computers, 1-8 GiB of RAM
# The Edge limit tables (config/limits/Kconfig.limits).
CONFIG_HWCLASS_SBC=y

# config/fragments/arch/riscv64.frag — ARCH riscv64
# The ISA; its baseline level and extension policies take their Kconfig
# defaults (config/arch/Kconfig.isa-riscv64).
CONFIG_ARCH_RISCV64=y

# config/fragments/build/dev.frag — BUILD_TYPE DEV: development: the test signing key, ktest and the canaries may be on
# BUILD_TYPE (config/axes/Kconfig.build): the defconfig names it; neither the
# board nor the preset decides it.
CONFIG_BUILD_TYPE_DEV=y
