# config/defconfigs/edge.config — RISC-V 64 / QEMU virt / Edge profile (default)
#
# Target: QEMU virt riscv64 (development / CI), also the Makefile fallback
#         when no .config exists.  qemu.config's values with the default
#         domain, Generic (qemu.config and robot-edge.config select Robot).
#
# Memory budget (rough):
#   Static tables (edge profile): ~3-4 MiB
#   Kernel heap (KERNEL_HEAP_SIZE = 32768 KiB): 32 MiB
#   Lazy user stacks (MAX_TASKS=64 × 16 KiB demand-paged): ~1 MiB physical
#   Total worst-case: ~36-37 MiB  (well within QEMU 256 MiB RAM)
#
# Notable vs. defaults: ALL values are at Kconfig defaults.
#   ARCH=RISCV64, BOARD=QEMU, HWCLASS=SBC (edge tables), TIMER_FREQ=10 MHz,
#   DRV_VIRTIO_BLK_NET=y (QEMU VirtIO),
#   WCET_BOUND_TIMER_ISR_US=0 (TCG SMP artefact mitigation).
#
# Used for: default `make` target, CI edge-profile build, quick iteration.
#
# Regenerate with:  make defconfig-edge && make savedefconfig

# Domain (wave 11, DOMAIN): none set, so the Kconfig default, Generic: no
# robot crate is linked. config/defconfigs/robot-edge.config is the same
# profile with PRESET_ROBOT (the robot worked example; the gate builds that).

CONFIG_PRESET_GENERIC=y
# Build type: development (config/Kconfig.development BUILD_TYPE; the
# defconfig names it, the board does not decide it).
CONFIG_BUILD_TYPE_DEV=y
