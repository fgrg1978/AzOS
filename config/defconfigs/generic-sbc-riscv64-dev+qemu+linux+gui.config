# config/defconfigs/generic-sbc-riscv64-dev+qemu+linux+gui.config — generated by tools/gen_defconfigs.py; do not edit
#
# Preset generic, hardware class sbc, riscv64, dev build; overlays: qemu, linux, gui.
# Edit the fragments under config/fragments/ and run `python3 tools/gen_defconfigs.py`.
# `make defconfig-generic-sbc-riscv64-dev+qemu+linux+gui` loads it.

# config/fragments/presets/generic.frag — PRESET GENERIC: General-purpose kernel
# The one line a defconfig needs: the preset sets the defaults of every axis
# (config/axes/Kconfig.preset).
CONFIG_PRESET_GENERIC=y

# config/fragments/hwclass/sbc.frag — HWCLASS SBC: single-board computers, 1-8 GiB of RAM
# The Edge limit tables (config/limits/Kconfig.limits).
CONFIG_HWCLASS_SBC=y

# config/fragments/arch/riscv64.frag — ARCH riscv64
# The ISA; its baseline level and extension policies take their Kconfig
# defaults (config/arch/Kconfig.isa-riscv64).
CONFIG_ARCH_RISCV64=y

# config/fragments/build/dev.frag — BUILD_TYPE DEV: development: the test signing key, ktest and the canaries may be on
# BUILD_TYPE (config/axes/Kconfig.build): the defconfig names it; neither the
# board nor the preset decides it.
CONFIG_BUILD_TYPE_DEV=y

# config/fragments/overlays/qemu.frag — QEMU development and test images
# Every line at the kernel console: the gate waits for info lines ("Starting
# scheduler on boot CPU"). A product build keeps its profile's level, warn.
CONFIG_LOG_LEVEL_DEBUG=y

# config/fragments/overlays/linux.frag — The Linux personality and the C library, on so the gate tests them
# Linux personality: off by default everywhere; on here so the gate tests it.
CONFIG_LINUX_ABI=y
# The C library and its test programs: `make relibc` builds them for this ISA.
CONFIG_RELIBC=y

# config/fragments/overlays/gui.frag — The input and audio servers, and what each ISA's gate machine can show it
# The input server (INPUTD) on every ISA; gui-riscv64.frag adds the compositor
# on QEMU's ramfb, gui-x86_64.frag the USB keyboard of the x86_64 machine.
CONFIG_INPUTD=y
# The audio server (config/subsys/Kconfig.audio AUDIOD): the gate's `beep` rows play
# through it, and its own row mixes two beeps. A robot image has no speaker to
# share, so the symbol is n by default there; the QEMU gate machines have
# virtio-sound.
CONFIG_AUDIOD=y

# config/fragments/overlays/gui-riscv64.frag — The compositor on QEMU ramfb (riscv64)
# The compositor and the framebuffer it composes onto (QEMU ramfb, which the
# kernel drives only when it is built with the `ramfb` feature and QEMU has the
# device: the generic rows boot the same userspace with no framebuffer, where the
# compositor runs headless). On here so the gate tests the trusted path: after
# Ctrl+Alt+Delete the input server refuses every caller but the compositor the
# focus. 6000 ms of banner (the default is 1500) so the gate's typed refusal
# lands inside the interval, and the `input` row's status before the compositor
# hands the focus on, on a loaded host.
CONFIG_DRV_DISPLAY_RAMFB=y
CONFIG_COMPOSITOR=y
CONFIG_COMPOSITOR_BANNER_MS=6000
