# config/defconfigs/qemu.config — RISC-V 64 / QEMU virt / Edge profile
#
# Target: QEMU virt riscv64 (development / CI).
#         Explicit named alias so CI pipelines can reference it by name
#         independently of the `edge` fallback.
#
# Memory budget (rough):
#   Static tables (edge profile): ~3-4 MiB
#   Kernel heap (KERNEL_HEAP_SIZE = 32768 KiB): 32 MiB
#   Lazy user stacks (MAX_TASKS=64 × 16 KiB demand-paged): ~1 MiB physical
#   Total worst-case: ~36-37 MiB  (well within QEMU 256 MiB RAM)
#
# Notable vs. defaults: ALL values are at Kconfig defaults.
#   ARCH=RISCV64, BOARD=QEMU, PROFILE=EDGE, TIMER_FREQ=10 MHz,
#   DRV_VIRTIO_BLK_NET=y (QEMU VirtIO),
#   WCET_BOUND_TIMER_ISR_US=0 (TCG SMP artefact mitigation).
#
# Used for: explicit CI QEMU build, `make defconfig-qemu && make`.
#
# Regenerate with:  make defconfig-qemu && make savedefconfig

# Ring-3 driver proxy spin before blocking (config/Kconfig.drivers PROXY_SPIN_US).
# 20 us: measured under QEMU TCG (wave 9).
# CONFIG_PRESET_ROBOT=y (PRESET; USE robot, wave 11 DOMAIN): this image is the robot worked
# example, and the gate's robot rows build from it. The domain is what links
# the robot crates (kernel feature `use-robot`); `make config` from
# scratch defaults to USE_GENERIC.

CONFIG_PRESET_ROBOT=y
CONFIG_PROXY_SPIN_US=20

# Linux personality: off by default everywhere; on here so the gate tests it.
CONFIG_LINUX_ABI=y
# The C library and its test programs: `make relibc` builds them for this ISA.
CONFIG_RELIBC=y
CONFIG_LOG_LEVEL_DEBUG=y
CONFIG_INPUTD=y
# The compositor and the framebuffer it composes onto (QEMU ramfb, which the
# kernel drives only when it is built with the `ramfb` feature and QEMU has the
# device: the generic rows boot the same userspace with no framebuffer, where the
# compositor runs headless). On here so the gate tests the trusted path: after
# Ctrl+Alt+Delete the input server refuses every caller but the compositor the
# focus. 6000 ms of banner (the default is 1500) so the gate's typed refusal
# lands inside the interval, and the `input` row's status before the compositor
# hands the focus on, on a loaded host.
CONFIG_FB_GENERIC=y
CONFIG_DRV_DISPLAY_RAMFB=y
CONFIG_COMPOSITOR=y
CONFIG_COMPOSITOR_BANNER_MS=6000

# The audio server (config/Kconfig.audio AUDIOD): the gate's `beep` rows play
# through it, and its own row mixes two beeps. A robot image has no speaker to
# share, so the symbol is n by default there; this QEMU image has virtio-sound.
CONFIG_AUDIOD=y
