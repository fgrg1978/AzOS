# config/defconfigs/qemu-x86_64-limine.config — qemu-x86_64.config booted through
# the Limine protocol (`make x86_64-limine`, `make run-x86-pc`) instead of PVH.
# Original header follows.
#
# config/defconfigs/qemu-x86_64.config — x86_64 port SKELETON
#
# Not a bootable configuration: the x86_64 port is a skeleton (every arch
# method todo!(), asm stubs; see config/Kconfig.arch ARCH_X86_64). The one
# thing built from this file:
#   make ARCH=x86_64 check  — expands it into $AZOS_OUT/build/check-x86_64.config and
#                             type-checks the kernel for x86_64-unknown-none
# Its errors and compile_error!s are the porting checklist.

CONFIG_PRESET_ROBOT=y

CONFIG_ARCH_X86_64=y
CONFIG_X86_64_LEVEL_V2=y

CONFIG_LINUX_ABI=y
CONFIG_LOG_LEVEL_DEBUG=y
CONFIG_X86_BOOT_LIMINE=y

# The Limine framebuffer as a console and a panic screen.
CONFIG_FB_GENERIC=y
CONFIG_FB_CONSOLE=y
CONFIG_FB_PANIC_SCREEN=y

# The PC image is the PS/2 driver's user (q35 has an i8042 and no virtio-mmio
# keyboard); the Robot preset this file starts from leaves DRV_PS2 off.
CONFIG_DRV_PS2=y
# Build type: development (config/Kconfig.development BUILD_TYPE; the
# defconfig names it, the board does not decide it).
CONFIG_BUILD_TYPE_DEV=y
