# config/defconfigs/qemu-guest.config — RISC-V 64 / AzOS as a guest of AzOS
#
# The kernel that runs inside the hypervisor of qemu-hv-guest.config (`make
# azos-guest`, tools/run_guest.sh). It is qemu.config's machine (QEMU `virt`
# map: RAM at 0x8000_0000, the kernel at 0x8020_0000, virtio-mmio at
# 0x1000_1000) cut down to what a guest needs:
#   * no hypervisor inside (VIRT = none, the default): a guest does not host a guest;
#   * small RAM (RAM_SIZE and KERNEL_HEAP_SIZE): the host's example guest has
#     HV_EXAMPLE_GUEST_MEM_MIB = 24 MiB, MemObj frames its VMMD.ELF creates;
#   * the general preset: no robot crates, no Linux personality, no C library,
#     no component manager. Its devices are the host's virtio-mmio backends
#     (console, block, net), whose drivers the kernel has unconditionally.
# `make ARCH=riscv64 check CHECK_DEFCONFIG_riscv64=config/defconfigs/qemu-guest.config`
# type-checks it.

CONFIG_PRESET_GENERIC=y
CONFIG_LOG_LEVEL_DEBUG=y
CONFIG_RAM_SIZE=24
CONFIG_KERNEL_HEAP_SIZE=8192
