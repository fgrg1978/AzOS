# config/defconfigs/embedded.config — RISC-V 64 / Generic board / Embedded profile
#
# Target: rv64 SoC with 16-64 MiB of RAM, OpenSBI at the base of RAM.
#         Pure profile preset — the smallest sizing on rv64. Use as a
#         starting point for board bring-up on any rv64 platform not yet
#         listed in config/Kconfig.platform.
#
# Build (never touches the workspace .config):
#   cp config/defconfigs/embedded.config <dir>/embedded.config
#   KCONFIG_CONFIG=<dir>/embedded.config python3 -m olddefconfig
#   KCONFIG_CONFIG=<dir>/embedded.config CARGO_TARGET_DIR=<dir> \
#     RUSTFLAGS="-C link-arg=-Tkernel/linker-embedded.ld -C code-model=medium -C target-feature=+zaamo,+zalrsc" \
#     cargo build --release $(python3 tools/kconfig_to_cargo.py <dir>/embedded.config)
#
# RAM_SIZE=64 sets the PMM bitmap ceiling (64 MiB = 16,384 pages, 2 KiB of
# .bss). The PMM manages the RAM the device tree reports, up to that ceiling,
# so the same image serves a 16 MiB and a 64 MiB board. kernel/linker-embedded.ld
# links it into the 14 MiB above OpenSBI and holds the image to a named budget.
#
# Memory: measured per subsystem by tools/size_report.sh.
#
# Notable vs. edge defaults:
#   ARCH=RISCV64, BOARD=GENERIC (fill in UART_BASE / PLIC_BASE / RAM_BASE manually;
#     the generic defaults are QEMU virt's addresses).
#   PROFILE_EMBEDDED — smallest cap tier (MAX_TASKS=32, TCP_MAX_CONNS=4,
#     MAX_CAPS_TOTAL=256, etc.; config/Kconfig.limits).
#   SCHED_HZ=100 (PROFILE_EMBEDDED default).
#   All drivers still enabled by default — disable per-board as needed.
#   WCET_BOUND_TIMER_ISR_US=10 (real hardware, non-QEMU default).
#   DRV_VIRTIO_BLK_NET=n (auto from !BOARD_QEMU).
#
# Used for: small-RAM rv64 bring-up, minimal kernel validation, platform porting.
#
# Regenerate with:  make defconfig-embedded && make savedefconfig
# Domain (wave 11, DOMAIN): none set, so the Kconfig default, Generic: no
# robot crate is linked. config/defconfigs/robot-embedded.config is the same
# profile with DOMAIN_ROBOT (the robot worked example; the gate builds that).

CONFIG_BOARD_GENERIC=y
CONFIG_RAM_SIZE=64
CONFIG_PROFILE_EMBEDDED=y
