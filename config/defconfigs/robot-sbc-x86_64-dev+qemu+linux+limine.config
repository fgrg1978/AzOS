# config/defconfigs/robot-sbc-x86_64-dev+qemu+linux+limine.config — generated by tools/build/gen_defconfigs.py; do not edit
#
# Preset robot, hardware class sbc, x86_64, dev build; overlays: qemu, linux, limine.
# Edit the fragments under config/fragments/ and run `python3 tools/build/gen_defconfigs.py`.
# `make defconfig-robot-sbc-x86_64-dev+qemu+linux+limine` loads it.

# config/fragments/presets/robot.frag — PRESET ROBOT: The robot worked example (links the robot crates, kernel feature `use-robot`)
# The one line a defconfig needs: the preset sets the defaults of every axis
# (config/axes/Kconfig.preset).
CONFIG_PRESET_ROBOT=y

# config/fragments/hwclass/sbc.frag — HWCLASS SBC: single-board computers, 1-8 GiB of RAM
# The Edge limit tables (config/limits/Kconfig.limits).
CONFIG_HWCLASS_SBC=y

# config/fragments/arch/x86_64.frag — ARCH x86_64
# The ISA; its baseline level and extension policies take their Kconfig
# defaults (config/arch/Kconfig.isa-x86_64).
CONFIG_ARCH_X86_64=y

# config/fragments/build/dev.frag — BUILD_TYPE DEV: development: the test signing key, ktest and the canaries may be on
# BUILD_TYPE (config/axes/Kconfig.build): the defconfig names it; neither the
# board nor the preset decides it.
CONFIG_BUILD_TYPE_DEV=y

# config/fragments/overlays/qemu.frag — QEMU development and test images
# Every line at the kernel console: the gate waits for info lines ("Starting
# scheduler on boot CPU"). A product build keeps its profile's level, warn.
CONFIG_LOG_LEVEL_DEBUG=y

# config/fragments/overlays/linux.frag — The Linux personality and the C library, on so the gate tests them
# Linux personality: off by default everywhere; on here so the gate tests it.
CONFIG_LINUX_ABI=y
# The C library and its test programs: `make relibc` builds them for this ISA.
CONFIG_RELIBC=y
# The gate's kernels carry no BusyBox: its BusyBox rows build their own
# configuration with both on, and the rows that read "BusyBox off" depend on
# these lines. A development build outside the gate takes the Kconfig default
# (on with the Linux personality).
# CONFIG_USERSPACE_GPL is not set
# CONFIG_BUSYBOX is not set

# config/fragments/overlays/linux-x86_64.frag — the Linux personality on x86_64
# Hosted by the ring-3 runtime, which Kconfig turns on by default here; the gate
# keeps it off in the kernels that do not run a Linux task, and the rows that do
# add CONFIG_LINUX_RUNTIME=y to the defconfig.
# CONFIG_LINUX_RUNTIME is not set

# config/fragments/overlays/limine.frag — x86_64 booted by Limine, with a framebuffer console and a PS/2 keyboard
CONFIG_X86_BOOT_LIMINE=y
CONFIG_FB_GENERIC=y
CONFIG_FB_CONSOLE=y
CONFIG_FB_PANIC_SCREEN=y
CONFIG_DRV_PS2=y
