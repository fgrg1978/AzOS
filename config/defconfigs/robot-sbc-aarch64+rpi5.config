# config/defconfigs/robot-sbc-aarch64+rpi5.config — generated by tools/gen_defconfigs.py; do not edit
#
# Preset robot, hardware class sbc, aarch64, release (the default) build; overlays: rpi5.
# Edit the fragments under config/fragments/ and run `python3 tools/gen_defconfigs.py`.
# `make defconfig-robot-sbc-aarch64+rpi5` loads it.

# config/fragments/presets/robot.frag — PRESET ROBOT: The robot worked example (links the robot crates, kernel feature `use-robot`)
# The one line a defconfig needs: the preset sets the defaults of every axis
# (config/axes/Kconfig.preset).
CONFIG_PRESET_ROBOT=y

# config/fragments/hwclass/sbc.frag — HWCLASS SBC: single-board computers, 1-8 GiB of RAM
# The Edge limit tables (config/limits/Kconfig.limits).
CONFIG_HWCLASS_SBC=y

# config/fragments/arch/aarch64.frag — ARCH aarch64
# The ISA; its baseline level and extension policies take their Kconfig
# defaults (config/arch/Kconfig.isa-aarch64).
CONFIG_ARCH_AARCH64=y

# config/fragments/overlays/rpi5.frag — Raspberry Pi 5 (BCM2712): what its device tree does not give yet
# The board (BOARD_RPI5: its driver set, Armv8.2, the 54 MHz generic timer)
# until drivers bind from the device tree (kconfig sub-front F8).
CONFIG_BOARD_RPI5=y
# SoC resource frameworks (clock, reset, regulator, power domain from the
# device tree) and the PCI host driver (most peripherals sit behind the RP1
# southbridge on PCIe).
CONFIG_SOC_FRAMEWORKS=y
CONFIG_DRV_PCI=y
# The energy model from the firmware's ARM clock range (the mailbox), and with
# it the thermal task: `make rpi5` builds build/rpi5/kernel8.img for the Pi
# firmware (mk/kernel.mk, target rpi5).
CONFIG_ENERGY=y
