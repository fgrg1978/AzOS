# config/defconfigs/qemu-aarch64-hv.config — AArch64 / QEMU virt / hypervisor (EL2)
#
# qemu-aarch64.config plus the hypervisor role: VIRT = split (config/Kconfig.preset), which
# builds the hypervisor core (Kconfig HV, kernel feature `hv`) and probes the
# CPU's virtualization extension. Boot with `tools/qemu.sh hv-aarch64` (virtualization=on).
# `make ARCH=<isa> check CHECK_DEFCONFIG_<isa>=config/defconfigs/qemu-aarch64-hv.config` type-checks it; a boot
# needs a topology with a [guest.NAME] row (CAPS.TOML format 7) to admit a guest.
#
#
# Target: QEMU `virt` (GICv3, PL011, virtio-mmio), -cpu max, 128 MiB RAM at
#         0x4000_0000. The same kernel crate as RISC-V (azos_kernel),
#         built for aarch64-unknown-none and booted as an arm64 Image.
#
# Build and run:
#   make aarch64            — expands this file into $AZOS_OUT/build/aarch64.config
#                             (olddefconfig), builds, objcopies the Image
#   make qemu-aarch64       — boots it entered at EL1
#   make qemu-aarch64-el2   — boots it entered at EL2 (virtualization=on)
# The workspace .config is not read or written by those targets.
#
# Notable vs. RISC-V edge defaults:
#   ARCH=AARCH64 selects FP_NEON and the larger stack defaults in config/Kconfig.arch.
#   DRV_CSI=n            — no JH7110/K1 CSI block on QEMU virt.
#   DRV_VIRTIO_BLK_NET=n — the aarch64 boot path does not probe virtio-mmio yet.
#
# CONFIG_PRESET_ROBOT=y (PRESET; USE robot, wave 11 DOMAIN): this image is the robot worked
# example, and the gate's robot rows build from it. The domain is what links
# the robot crates (kernel feature `use-robot`); `make config` from
# scratch defaults to USE_GENERIC.

CONFIG_PRESET_ROBOT=y
CONFIG_ARCH_AARCH64=y
# CONFIG_DRV_CSI is not set
# CONFIG_DRV_VIRTIO_BLK_NET is not set
# CNTFRQ_EL0 on QEMU virt (>= 9.0) — see config/Kconfig.platform TIMER_FREQ
CONFIG_TIMER_FREQ=1000000000

# Ring-3 driver proxy spin before blocking (config/Kconfig.drivers PROXY_SPIN_US).
# 20 us: measured under QEMU TCG (wave 9).
CONFIG_PROXY_SPIN_US=20

# Linux personality: off by default everywhere; on here so the gate tests it.
CONFIG_LINUX_ABI=y
# The C library and its test programs: `make relibc` builds them for this ISA.
CONFIG_RELIBC=y
CONFIG_LOG_LEVEL_DEBUG=y

# The hypervisor role.
CONFIG_VIRT_SPLIT=y

# Guest RAM is MemObj frames VMMD.ELF creates (Kconfig.hv): the table's
# maximum lets a [guest.NAME] row ask for up to 32 MiB (4 KiB granule); the
# default 16 slots would refuse anything above 2 MiB.
CONFIG_MAX_MEMOBJS=256
# Build type: development (config/Kconfig.development BUILD_TYPE; the
# defconfig names it, the board does not decide it).
CONFIG_BUILD_TYPE_DEV=y
