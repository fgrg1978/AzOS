# config/defconfigs/generic-server-riscv64+board-generic.config — generated by tools/gen_defconfigs.py; do not edit
#
# Preset generic, hardware class server, riscv64, release (the default) build; overlays: board-generic.
# Edit the fragments under config/fragments/ and run `python3 tools/gen_defconfigs.py`.
# `make defconfig-generic-server-riscv64+board-generic` loads it.

# config/fragments/presets/generic.frag — PRESET GENERIC: General-purpose kernel
# The one line a defconfig needs: the preset sets the defaults of every axis
# (config/axes/Kconfig.preset).
CONFIG_PRESET_GENERIC=y

# config/fragments/hwclass/server.frag — HWCLASS SERVER: servers and gateway machines
# The Fleet limit tables (config/limits/Kconfig.limits).
CONFIG_HWCLASS_SERVER=y
# The RAM the class is built for (the build checks the 256 MiB kernel heap
# against it). Until the build takes it from the device tree (F7), the class
# names it.
CONFIG_RAM_SIZE=1024

# config/fragments/arch/riscv64.frag — ARCH riscv64
# The ISA; its baseline level and extension policies take their Kconfig
# defaults (config/arch/Kconfig.isa-riscv64).
CONFIG_ARCH_RISCV64=y

# config/fragments/overlays/board-generic.frag — A board the kernel has no BOARD_* entry for
# Generic / custom board: no board-specific driver set; what the board has
# comes from its device tree.
CONFIG_BOARD_GENERIC=y
