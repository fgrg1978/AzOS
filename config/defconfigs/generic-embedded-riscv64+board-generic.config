# config/defconfigs/generic-embedded-riscv64+board-generic.config — generated by tools/build/gen_defconfigs.py; do not edit
#
# Preset generic, hardware class embedded, riscv64, release (the default) build; overlays: board-generic.
# Edit the fragments under config/fragments/ and run `python3 tools/build/gen_defconfigs.py`.
# `make defconfig-generic-embedded-riscv64+board-generic` loads it.

# config/fragments/presets/generic.frag — PRESET GENERIC: General-purpose kernel
# The one line a defconfig needs: the preset sets the defaults of every axis
# (config/axes/Kconfig.preset).
CONFIG_PRESET_GENERIC=y

# config/fragments/hwclass/embedded.frag — HWCLASS EMBEDDED: small boards, 16-64 MiB of RAM
# The smallest limit tables (config/limits/Kconfig.limits).
CONFIG_HWCLASS_EMBEDDED=y
# The RAM the board is expected to have (the build checks the kernel heap
# against it); the PMM manages whatever RAM the device tree reports, so one
# image serves a 16 and a 64 MiB board. Until the build takes it from the
# device tree (kconfig sub-front F7), the class names it.
CONFIG_RAM_SIZE=64

# config/fragments/arch/riscv64.frag — ARCH riscv64
# The ISA; its baseline level and extension policies take their Kconfig
# defaults (config/arch/Kconfig.isa-riscv64).
CONFIG_ARCH_RISCV64=y

# config/fragments/overlays/board-generic.frag — A board the kernel has no BOARD_* entry for
# Generic / custom board: no board-specific driver set; what the board has
# comes from its device tree.
CONFIG_BOARD_GENERIC=y
