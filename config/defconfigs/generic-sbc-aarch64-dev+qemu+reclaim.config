# config/defconfigs/generic-sbc-aarch64-dev+qemu+reclaim.config — generated by tools/build/gen_defconfigs.py; do not edit
#
# Preset generic, hardware class sbc, aarch64, dev build; overlays: qemu, reclaim.
# Edit the fragments under config/fragments/ and run `python3 tools/build/gen_defconfigs.py`.
# `make defconfig-generic-sbc-aarch64-dev+qemu+reclaim` loads it.

# config/fragments/presets/generic.frag — PRESET GENERIC: General-purpose kernel
# The one line a defconfig needs: the preset sets the defaults of every axis
# (config/axes/Kconfig.preset).
CONFIG_PRESET_GENERIC=y

# config/fragments/hwclass/sbc.frag — HWCLASS SBC: single-board computers, 1-8 GiB of RAM
# The Edge limit tables (config/limits/Kconfig.limits).
CONFIG_HWCLASS_SBC=y

# config/fragments/arch/aarch64.frag — ARCH aarch64
# The ISA; its baseline level and extension policies take their Kconfig
# defaults (config/arch/Kconfig.isa-aarch64).
CONFIG_ARCH_AARCH64=y

# config/fragments/build/dev.frag — BUILD_TYPE DEV: development: the test signing key, ktest and the canaries may be on
# BUILD_TYPE (config/axes/Kconfig.build): the defconfig names it; neither the
# board nor the preset decides it.
CONFIG_BUILD_TYPE_DEV=y

# config/fragments/overlays/qemu.frag — QEMU development and test images
# Every line at the kernel console: the gate waits for info lines ("Starting
# scheduler on boot CPU"). A product build keeps its profile's level, warn.
# (LOG_LEVEL_DEBUG: set by config/fragments/overlays/reclaim.frag)

# config/fragments/overlays/reclaim.frag — Reclaim under real pressure (the gate's `reclaim:` rows)
# Compression and swap to a file, on a small machine, with MEMPRESS.ELF started
# to fill past its RAM and the decision ring on the console. The machine is small
# so the fill is short, and every table bound is opened so that the pool's room
# (Full) and not a table or a quota is what sends segments to swap. The other
# rows' budgets take most of what memory admission gives on a machine this
# size, so the watermarks are set where a program holding its whole budget takes
# the machine past the system's, and one its storms keep at its own does not. The
# swap file grows once: a grow zero-fills through the filesystem with the reclaim
# task waiting, and on a loaded host a step every few seconds starves the fill.
CONFIG_LOG_LEVEL_DEBUG=y
CONFIG_RAM_SIZE=128
CONFIG_KERNEL_HEAP_SIZE=8192
CONFIG_MM_RECLAIM_COMPRESS=y
CONFIG_MM_SWAP_BACKEND_FILE=y
CONFIG_MM_SWAP_SEGMENTS=256
CONFIG_MM_SWAP_FILE_GROW_SEGMENTS=128
CONFIG_MM_ZPOOL_ENTRIES=65536
CONFIG_MM_ZPOOL_DOMAIN_KIB=0
CONFIG_MM_AGING_INTERVAL_MS=100
CONFIG_MM_RECLAIM_POLL_MS=50
CONFIG_MM_RECLAIM_HIGH_PCT=40
CONFIG_MM_RECLAIM_LOW_PCT=30
CONFIG_MM_PRESSURE_TEST_PAGES=10000
CONFIG_USERSPACE_MEMPRESS=y
CONFIG_DECISION_RECORDS_CONSOLE=y
