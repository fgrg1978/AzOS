# config/defconfigs/qemu-aarch64.config — aarch64 / QEMU virt / edge profile
#
# Target: QEMU `virt` (GICv3, PL011, virtio-mmio), -cpu max, 128 MiB RAM at
#         0x4000_0000. The same kernel crate as RISC-V (azos_kernel),
#         built for aarch64-unknown-none and booted as an arm64 Image.
#
# Build and run:
#   make aarch64            — expands this file into build/aarch64.config
#                             (olddefconfig), builds, objcopies the Image
#   make qemu-aarch64       — boots it entered at EL1
#   make qemu-aarch64-el2   — boots it entered at EL2 (virtualization=on)
# The workspace .config is not read or written by those targets.
#
# Notable vs. RISC-V edge defaults:
#   ARCH=AARCH64 selects FP_NEON and the larger stack defaults in config/Kconfig.arch.
#   DRV_CSI=n            — no JH7110/K1 CSI block on QEMU virt.
#   DRV_VIRTIO_BLK_NET=n — the aarch64 boot path does not probe virtio-mmio yet.
#
# Regenerate with:  make defconfig-qemu-aarch64 && make savedefconfig
# CONFIG_DOMAIN_ROBOT=y (wave 11, DOMAIN): this image is the robot worked
# example, and the gate's robot rows build from it. The domain is what links
# the robot crates (kernel feature `domain-robot`); `make config` from
# scratch defaults to DOMAIN_GENERIC.
CONFIG_DOMAIN_ROBOT=y

CONFIG_ARCH_AARCH64=y
# CONFIG_DRV_CSI is not set
# CONFIG_DRV_VIRTIO_BLK_NET is not set
# CNTFRQ_EL0 on QEMU virt (>= 9.0) — see config/Kconfig.platform TIMER_FREQ
CONFIG_TIMER_FREQ=1000000000

# Ring-3 driver proxy spin before blocking (config/Kconfig.drivers PROXY_SPIN_US).
# 20 us: measured under QEMU TCG (wave 9).
CONFIG_PROXY_SPIN_US=20

# Linux personality: off by default everywhere; on here so the gate tests it.
CONFIG_LINUX_ABI=y
CONFIG_LOG_LEVEL_DEBUG=y
