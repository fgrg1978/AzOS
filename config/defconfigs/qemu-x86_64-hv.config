# config/defconfigs/qemu-x86_64-hv.config — x86_64 / hypervisor (AMD SVM)
#
# qemu-x86_64.config plus the hypervisor role: VIRT = hosted (config/Kconfig.preset), which
# builds the hypervisor core (Kconfig HV, kernel feature `hv`) and probes the
# CPU's virtualization extension. Boot with `tools/qemu.sh hv-x86_64` (-cpu max,svm=on).
# `make ARCH=<isa> check CHECK_DEFCONFIG_<isa>=config/defconfigs/qemu-x86_64-hv.config` type-checks it; a boot
# needs a topology with a [guest.NAME] row (CAPS.TOML format 7) to admit a guest.
#
#
# Not a bootable configuration: the x86_64 port is a skeleton (every arch
# method todo!(), asm stubs; see config/Kconfig.arch ARCH_X86_64). The one
# thing built from this file:
#   make ARCH=x86_64 check  — expands it into $AZOS_OUT/build/check-x86_64.config and
#                             type-checks the kernel for x86_64-unknown-none
# Its errors and compile_error!s are the porting checklist.


CONFIG_PRESET_ROBOT=y
CONFIG_ARCH_X86_64=y
CONFIG_X86_64_LEVEL_V2=y

CONFIG_LINUX_ABI=y
# The C library and its test programs: `make relibc` builds them for this ISA.
CONFIG_RELIBC=y
CONFIG_LOG_LEVEL_DEBUG=y

# The hypervisor role.
CONFIG_VIRT_HOSTED=y

# Guest RAM is MemObj frames VMMD.ELF creates (Kconfig.hv): the table's
# maximum lets a [guest.NAME] row ask for up to 32 MiB (4 KiB granule); the
# default 16 slots would refuse anything above 2 MiB.
CONFIG_MAX_MEMOBJS=256
# Build type: development (config/Kconfig.development BUILD_TYPE; the
# defconfig names it, the board does not decide it).
CONFIG_BUILD_TYPE_DEV=y
