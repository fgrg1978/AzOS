# config/defconfigs/robot-sbc-riscv64+vf2.config — generated by tools/gen_defconfigs.py; do not edit
#
# Preset robot, hardware class sbc, riscv64, release (the default) build; overlays: vf2.
# Edit the fragments under config/fragments/ and run `python3 tools/gen_defconfigs.py`.
# `make defconfig-robot-sbc-riscv64+vf2` loads it.

# config/fragments/presets/robot.frag — PRESET ROBOT: The robot worked example (links the robot crates, kernel feature `use-robot`)
# The one line a defconfig needs: the preset sets the defaults of every axis
# (config/axes/Kconfig.preset).
CONFIG_PRESET_ROBOT=y

# config/fragments/hwclass/sbc.frag — HWCLASS SBC: single-board computers, 1-8 GiB of RAM
# The Edge limit tables (config/limits/Kconfig.limits).
CONFIG_HWCLASS_SBC=y

# config/fragments/arch/riscv64.frag — ARCH riscv64
# The ISA; its baseline level and extension policies take their Kconfig
# defaults (config/arch/Kconfig.isa-riscv64).
CONFIG_ARCH_RISCV64=y

# config/fragments/overlays/vf2.frag — StarFive VisionFive 2 (JH7110): what its device tree does not give yet
# The board (BOARD_VF2: its driver set, RV64GC, the SoC frameworks on by
# default) until drivers bind from the device tree (kconfig sub-front F8).
CONFIG_BOARD_VF2=y
# The PCI host driver.
CONFIG_DRV_PCI=y
