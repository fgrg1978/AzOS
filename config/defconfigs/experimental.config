# config/defconfigs/experimental.config — Edge/QEMU base + Phase-B experiment flags ON
#
# Target: same as `qemu`/`edge` (RISC-V 64 / QEMU virt / Edge profile) but with
#         the in-flight Phase-B innovation experiments enabled BY DEFAULT.
#
# This is the honest way to ship "experiments on by default": the base Kconfig
# keeps `default n` for each flag (so a plain build never silently claims an
# unimplemented feature), and THIS profile opts both in. Build with:
#     make defconfig-experimental && make
#
# Flags enabled here (vs Kconfig defaults):
#   CONFIG_MULTISTREAM_SCHED_PRIORITY=y — control stream preempts bulk on the
#       multi-stream link.
#       STATUS: rejected. The re-measured hold-off ratio is 8.4-8.6x over 14
#       paired boots, not the >= 10x target, and 8.0x is the arithmetic ceiling
#       at 16 KiB / 1460 B chunks (the 3 B multi-stream header spills each
#       chunk across the 1460 B MSS). The earlier "~10x, measured" claim was a
#       single n=1 pairing and does not reproduce.
#       The production chunked-interleave sender was never built, so this flag
#       still selects a FIFO-equivalent seam. Kept as a config seam only; do
#       NOT read it as an accepted optimisation.
#   CONFIG_CONTROL_PLANE_ASYNC=y — stackless cooperative async control plane
#       (~8.8x cheaper task resume, measured proxy).
#       NOTE: the async executor is not yet built; until it lands this flag is
#       inert at runtime (seam + measurement only).
#
# Neither is accepted: the multi-stream priority flag is rejected (seam kept,
# see above) and the async control plane is still an experiment. Promote to the
# base defaults only when their mechanisms are implemented + validated
# end-to-end.
#
# Everything else inherits Edge/QEMU Kconfig defaults via `olddefconfig`.
#
# Regenerate with:  make defconfig-experimental && make savedefconfig
#
# CONFIG_PRESET_ROBOT=y (PRESET; USE robot, wave 11): MULTISTREAM_SCHED_PRIORITY lives in the
# Robot menu, which is shown only for the Robot domain; olddefconfig drops a
# value set on a hidden option, so without this line the flag would be lost.

CONFIG_PRESET_ROBOT=y
CONFIG_MULTISTREAM_SCHED_PRIORITY=y
CONFIG_CONTROL_PLANE_ASYNC=y
# CONTROL_TXN_TICKS is now ACCEPTED (default y in Kconfig) — no longer listed here.
# Build type: development (config/Kconfig.development BUILD_TYPE; the
# defconfig names it, the board does not decide it).
CONFIG_BUILD_TYPE_DEV=y
