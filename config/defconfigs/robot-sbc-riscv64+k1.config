# config/defconfigs/robot-sbc-riscv64+k1.config — generated by tools/gen_defconfigs.py; do not edit
#
# Preset robot, hardware class sbc, riscv64, release (the default) build; overlays: k1.
# Edit the fragments under config/fragments/ and run `python3 tools/gen_defconfigs.py`.
# `make defconfig-robot-sbc-riscv64+k1` loads it.

# config/fragments/presets/robot.frag — PRESET ROBOT: The robot worked example (links the robot crates, kernel feature `use-robot`)
# The one line a defconfig needs: the preset sets the defaults of every axis
# (config/axes/Kconfig.preset).
CONFIG_PRESET_ROBOT=y

# config/fragments/hwclass/sbc.frag — HWCLASS SBC: single-board computers, 1-8 GiB of RAM
# The Edge limit tables (config/limits/Kconfig.limits).
CONFIG_HWCLASS_SBC=y

# config/fragments/arch/riscv64.frag — ARCH riscv64
# The ISA; its baseline level and extension policies take their Kconfig
# defaults (config/arch/Kconfig.isa-riscv64).
CONFIG_ARCH_RISCV64=y

# config/fragments/overlays/k1.frag — SpacemiT K1 / BananaPi BPI-F3: what its device tree does not give yet
# The board (BOARD_K1: its driver set, RV64GCV, the SoC frameworks on by
# default) until drivers bind from the device tree (kconfig sub-front F8).
CONFIG_BOARD_K1=y
# The K1 I2C controller moves one byte per service step (config/subsys/Kconfig.drivers
# I2C_SERVICE_POLL_US): the minimum keeps a 17-byte IMU burst well inside
# I2C_XFER_TIMEOUT_US. Board validation pending.
CONFIG_I2C_SERVICE_POLL_US=50
# Energy model: the K1's clusters take their OPPs and voltages from the device
# tree and the thermal task moves the P1 PMIC's buck with the clock
# (kernel/src/boot/thermal.rs; THERMAL follows ENERGY on a robot image).
# Without it the K1 image links the frameworks and never moves a clock or a rail.
CONFIG_ENERGY=y
