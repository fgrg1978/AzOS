# config/defconfigs/qemu-aarch64-guest.config — AArch64 / AzOS as a guest of AzOS
#
# The kernel that runs inside the hypervisor of qemu-aarch64-hv-guest.config (`make
# azos-guest ARCH=aarch64`, tools/run_guest.sh). qemu-aarch64.config's machine
# (QEMU `virt` map: RAM at 0x4000_0000, the kernel at 0x4008_0000, virtio-mmio
# at 0x0a00_0000) cut down to what a guest needs, as qemu-guest.config does:
# no hypervisor inside (VIRT = none), small RAM, the general preset, the host's
# virtio-mmio console, block and net backends.
# `make ARCH=aarch64 check CHECK_DEFCONFIG_aarch64=config/defconfigs/qemu-aarch64-guest.config`
# type-checks it.

CONFIG_PRESET_GENERIC=y
CONFIG_ARCH_AARCH64=y
# CNTFRQ_EL0 on QEMU virt (>= 9.0) — see config/Kconfig.platform TIMER_FREQ
CONFIG_TIMER_FREQ=1000000000
CONFIG_LOG_LEVEL_DEBUG=y
CONFIG_RAM_SIZE=24
CONFIG_KERNEL_HEAP_SIZE=8192
# Build type: development (config/Kconfig.development BUILD_TYPE; the
# defconfig names it, the board does not decide it).
CONFIG_BUILD_TYPE_DEV=y
