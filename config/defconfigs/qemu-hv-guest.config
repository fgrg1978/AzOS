# config/defconfigs/qemu-hv-guest.config — RISC-V 64 / QEMU virt / hypervisor: the host of `make azos-guest`
#
# qemu.config plus the hypervisor role: VIRT = hosted (config/Kconfig.preset), which
# builds the hypervisor core (Kconfig HV, kernel feature `hv`) and probes the
# CPU's virtualization extension. Boot with `tools/qemu.sh hv-riscv64` (-cpu rv64,h=true).
# `make ARCH=<isa> check CHECK_DEFCONFIG_<isa>=config/defconfigs/qemu-hv-guest.config` type-checks it; a boot
# needs a topology with a [guest.NAME] row (CAPS.TOML format 7) to admit a guest.
#
#
# Target: QEMU virt riscv64 (development / CI).
#         Explicit named alias so CI pipelines can reference it by name
#         independently of the `edge` fallback.
#
# Memory budget (rough):
#   Static tables (edge profile): ~3-4 MiB
#   Kernel heap (KERNEL_HEAP_SIZE = 32768 KiB): 32 MiB
#   Lazy user stacks (MAX_TASKS=64 × 16 KiB demand-paged): ~1 MiB physical
#   Total worst-case: ~36-37 MiB  (well within QEMU 256 MiB RAM)
#
# Notable vs. defaults: ALL values are at Kconfig defaults.
#   ARCH=RISCV64, BOARD=QEMU, HWCLASS=SBC (edge tables), TIMER_FREQ=10 MHz,
#   DRV_VIRTIO_BLK_NET=y (QEMU VirtIO),
#   WCET_BOUND_TIMER_ISR_US=0 (TCG SMP artefact mitigation).
#
# Used for: explicit CI QEMU build, `make defconfig-qemu && make`.
#

# Ring-3 driver proxy spin before blocking (config/Kconfig.drivers PROXY_SPIN_US).
# 20 us: measured under QEMU TCG (wave 9).
# CONFIG_PRESET_ROBOT=y (PRESET; USE robot, wave 11 DOMAIN): this image is the robot worked
# example, and the gate's robot rows build from it. The domain is what links
# the robot crates (kernel feature `use-robot`); `make config` from
# scratch defaults to USE_GENERIC.

CONFIG_PRESET_ROBOT=y
CONFIG_PROXY_SPIN_US=20

# Linux personality: off by default everywhere; on here so the gate tests it.
CONFIG_LINUX_ABI=y
# The C library and its test programs: `make relibc` builds them for this ISA.
CONFIG_RELIBC=y
CONFIG_LOG_LEVEL_DEBUG=y
# No component manager: the kernel's own launcher starts VMMD.ELF (a
# `start = true` row). The manager's row holds no launch grant on the images it
# starts, so on a hypervisor host it refuses VMMD.ELF ("holds no launch grant");
# this host is a separate defconfig so the other hypervisor rows keep their manager.
# CONFIG_COMPMGR is not set

# The hypervisor role.
CONFIG_VIRT_HOSTED=y

# Guest RAM is MemObj frames VMMD.ELF creates (Kconfig.hv): the table's
# maximum lets a [guest.NAME] row ask for up to 32 MiB (4 KiB granule); the
# default 16 slots would refuse anything above 2 MiB.
CONFIG_MAX_MEMOBJS=256

# The example guest (Kconfig HV_EXAMPLE_GUEST): the built-in topology declares
# `[guest.azos]`; `make azos-guest` puts the guest kernel (qemu-guest.config) on this
# host's volume and tools/run_guest.sh boots both.
CONFIG_HV_EXAMPLE_GUEST=y
# Build type: development (config/Kconfig.development BUILD_TYPE; the
# defconfig names it, the board does not decide it).
CONFIG_BUILD_TYPE_DEV=y
