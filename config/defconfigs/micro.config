# config/defconfigs/micro.config — AzOS-micro on QEMU virt (riscv32imac, PMP)
#
# `make micro` expands this into build/micro.config. The ISA choices are the
# main kernel's (riscv64 is the Kconfig default and is not built); what the
# micro kernel reads is MICRO_*, the topology limits (embedded class) and
# BUILD_TYPE_DEV, which lets the topology verify against the test key.
#
# Regenerate with:  make micro-config

CONFIG_PRESET_GENERIC=y
CONFIG_BOARD_GENERIC=y
CONFIG_RAM_SIZE=64
CONFIG_HWCLASS_EMBEDDED=y
CONFIG_BUILD_TYPE_DEV=y
CONFIG_MICRO=y
