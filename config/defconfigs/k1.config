# config/defconfigs/k1.config — SpacemiT K1 / BananaPi BPI-F3 — Edge profile
#
# Target: SpacemiT K1 SoC, 8-core rv64gcv @ 1.6 GHz + RVV V1.0 (VLEN=256),
#         LPDDR4X up to 16 GiB.  ML/CNN acceleration via NPU + RVV.
#
# Memory budget (rough):
#   Static tables (edge profile): ~3-4 MiB
#   Kernel heap (KERNEL_HEAP_SIZE = 32768 KiB): 32 MiB
#   Lazy user stacks (MAX_TASKS=64 × 16 KiB demand-paged): ~1 MiB physical
#   RVV context per task (FP_RVV, VLEN=256 → 1 KiB/task): ~64 KiB extra
#   Total worst-case: ~37-38 MiB  (well within K1 LPDDR4X capacity)
#
# Notable vs. edge defaults:
#   BOARD=K1 (K1 UART/GMAC/ISP drivers, no VirtIO, no MACB).
#   RISCV64_LEVEL=rv64gcv, RV_V and RV_ZBA/ZBB/ZBS=require (board defaults) — V1.0 (VLEN=256).
#   TIMER_FREQ=24000000 — K1 CLINT at 24 MHz (Kconfig default for BOARD_K1).
#   SCHED_HZ=250  (HWCLASS_SBC && BOARD_K1 default, 1.6 GHz handles 250 Hz fine).
#   WCET_BOUND_PID_US=50 (K1 1.6 GHz + RVV; fastest PID bound in the matrix).
#   DRV_NPU_ACCEL=y (auto from BOARD_K1 default).
#   DRV_VIRTIO_BLK_NET=n (auto from !BOARD_QEMU).
#   DRV_MACB_ETHERNET=n (auto from !BOARD_VF2).
#   DRV_USB_MSC_GADGET=y (BOARD_K1 default).
#
# Used for: K1 hardware bring-up; ML inference performance tuning.
#
# Regenerate with:  make defconfig-k1 && make savedefconfig
# CONFIG_PRESET_ROBOT=y (PRESET; USE robot, wave 11 DOMAIN): this image is the robot worked
# example, and the gate's robot rows build from it. The domain is what links
# the robot crates (kernel feature `use-robot`); `make config` from
# scratch defaults to USE_GENERIC.

CONFIG_PRESET_ROBOT=y
CONFIG_BOARD_K1=y

# Ring-3 driver proxy spin before blocking (config/Kconfig.drivers PROXY_SPIN_US).
# 20 us is the QEMU-measured value; the symbol's help says how to measure
# it on this board.
CONFIG_PROXY_SPIN_US=20

# SoC resource frameworks (clock, reset, regulator, power domain from the device
# tree; config/Kconfig.platform). Both are the BOARD_K1 defaults, pinned here so
# a change of default cannot unlink them from the board image unseen:
# tools/test_kconfig_to_cargo.py expects the features `soc` and `soc-k1` in this
# image's output.
CONFIG_SOC_FRAMEWORKS=y
CONFIG_SOC_K1=y

# The K1 I2C controller moves one byte per service step (config/Kconfig.drivers
# I2C_SERVICE_POLL_US): the minimum keeps a 17-byte IMU burst well inside
# I2C_XFER_TIMEOUT_US. Board validation pending.
CONFIG_I2C_SERVICE_POLL_US=50

# Energy model and thermal framework: the K1's clusters take their OPPs and
# voltages from the device tree and the thermal task moves the P1 PMIC's buck
# with the clock (kernel/src/boot/thermal.rs). Without these two the K1 image
# links the frameworks and never moves a clock or a rail.
CONFIG_ENERGY=y
CONFIG_THERMAL=y
