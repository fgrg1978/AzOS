# config/defconfigs/microvm-sbc-aarch64-dev+qemu.config — generated by tools/build/gen_defconfigs.py; do not edit
#
# Preset microvm, hardware class sbc, aarch64, dev build; overlays: qemu.
# Edit the fragments under config/fragments/ and run `python3 tools/build/gen_defconfigs.py`.
# `make defconfig-microvm-sbc-aarch64-dev+qemu` loads it.

# config/fragments/presets/microvm.frag — PRESET MICROVM: a guest of a hypervisor, virtio devices only
# The one line a defconfig needs: the preset sets the defaults of every axis
# (config/axes/Kconfig.preset).
CONFIG_PRESET_MICROVM=y

# config/fragments/hwclass/sbc.frag — HWCLASS SBC: single-board computers, 1-8 GiB of RAM
# The Edge limit tables (config/limits/Kconfig.limits).
CONFIG_HWCLASS_SBC=y

# config/fragments/arch/aarch64.frag — ARCH aarch64
# The ISA; its baseline level and extension policies take their Kconfig
# defaults (config/arch/Kconfig.isa-aarch64).
CONFIG_ARCH_AARCH64=y

# config/fragments/build/dev.frag — BUILD_TYPE DEV: development: the test signing key, ktest and the canaries may be on
# BUILD_TYPE (config/axes/Kconfig.build): the defconfig names it; neither the
# board nor the preset decides it.
CONFIG_BUILD_TYPE_DEV=y

# config/fragments/overlays/qemu.frag — QEMU development and test images
# Every line at the kernel console: the gate waits for info lines ("Starting
# scheduler on boot CPU"). A product build keeps its profile's level, warn.
CONFIG_LOG_LEVEL_DEBUG=y
